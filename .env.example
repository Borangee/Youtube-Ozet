# Bu dosyayı .env olarak kopyalayıp doldur. AI Studio'da bunları Ayarlar > Secrets bölümüne ekle.
# .env dosyası .gitignore'da; asla repoya ekleme.

# Gemini API anahtarı (AI Studio bunu otomatik ekler)
GEMINI_API_KEY=""

# Uygulamaya giriş şifresi. Tanımlıysa arayüz ve API şifre ister. Mutlaka tanımla.
APP_PASSWORD=""

# --- İsteğe bağlı ---------------------------------------------------------

# E-posta ayarları arayüzden de girilebilir; arayüzde kaydedilen değer önceliklidir.
SENDER_EMAIL=""
EMAIL_APP_PASSWORD=""          # Gmail 16 haneli uygulama şifresi
RECEIVER_EMAIL=""              # Birden fazla adres virgülle ayrılabilir
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"

# Dış zamanlayıcı (cron-job.org vb.) ve bot.py eşitlemesi için gizli anahtar.
# Boş bırakılırsa rastgele üretilir ve data/state.json'da saklanır.
CRON_SECRET=""

# Kullanılacak Gemini modeli (virgülle birden fazla yazılabilir, sırayla denenir)
GEMINI_MODEL=""

# Kanal listesi ve geçmişin tutulacağı klasör (varsayılan: ./data)
DATA_DIR=""

# E-postadaki tarihlerin saat dilimi
TZ="Europe/Istanbul"

# AI Studio uygulamanın adresini buraya otomatik yazar
APP_URL=""
